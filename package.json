{
  "name": "watch-flights",
  "version": "1.0.0",
  "private": true,
  "description": "Live ADS-B aircraft around configured locations, as a terminal CLI and an iOS app",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @watch-flights/cli",
    "build": "npm run build -w @watch-flights/cli",
    "start": "npm start -w @watch-flights/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
